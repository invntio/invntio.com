---
import Dotted from "./Dotted.astro";
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="section" id="about" aria-labelledby="about-title">
    <div class="wrap">
        <div class="about" data-reveal>
        <div class="statement">
            <h2 id="about-title"><Dotted text={t.about.title} period /></h2>
            {t.about.body.map((p) => <p>{p}</p>)}
        </div>
        <dl class="points">
            {t.about.points.map((pt) => (
                <div>
                    <dt>{pt.title}</dt>
                    <dd>{pt.body}</dd>
                </div>
            ))}
        </dl>
        </div>
    </div>
</section>

<style>
    .about {
        display: grid;
        gap: 3rem;
        padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
        border-top: 1px solid var(--ink);
    }
    @media (min-width: 900px) {
        .about {
            grid-template-columns: 7fr 5fr;
            column-gap: 4rem;
        }
    }
    h2 {
        font-size: var(--step-3);
        max-width: 16ch;
        margin-bottom: 1.5rem;
    }
    .statement p {
        font-size: var(--step-1);
        color: var(--ink-2);
        max-width: 54ch;
    }
    .statement p + p {
        margin-top: 1rem;
    }
    .points {
        display: grid;
        align-content: start;
    }
    .points div {
        padding-block: 1.25rem;
        border-bottom: 1px solid var(--rule);
    }
    .points div:first-child {
        border-top: 1px solid var(--rule);
    }
    dt {
        font-weight: 650;
    }
    dd {
        margin-top: 0.25rem;
        color: var(--ink-2);
        font-size: var(--step--1);
    }
</style>
