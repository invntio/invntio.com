---
import { getLang, localizePath, useTranslations } from "../i18n/ui";
import { site } from "../config/site";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const f = t.contact.form;
---

<section class="section" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="contact-title">{t.contact.title}</h2>
            <p>{t.contact.lede}</p>
        </div>

        <div class="contact">
            <dl class="details">
                <div>
                    <dt>{t.contact.email}</dt>
                    <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
                </div>
                <div>
                    <dt>{t.contact.location}</dt>
                    <dd>{site.location[lang]}</dd>
                </div>
            </dl>

            <form class="form" action="https://api.web3forms.com/submit" method="POST" data-contact-form novalidate>
                <input type="hidden" name="access_key" value={site.formAccessKey} />
                <input type="hidden" name="subject" value={f.subject} />
                <input type="hidden" name="from_name" value="invntio.com" />
                <input type="hidden" name="language" value={lang} />
                <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

                <div class="field">
                    <label for="cf-name">{f.name}</label>
                    <input id="cf-name" name="name" type="text" autocomplete="name" required />
                </div>
                <div class="field">
                    <label for="cf-email">{f.email}</label>
                    <input id="cf-email" name="email" type="email" autocomplete="email" required />
                </div>
                <div class="field">
                    <label for="cf-company">{f.company} <span class="opt">({f.optional})</span></label>
                    <input id="cf-company" name="company" type="text" autocomplete="organization" />
                </div>
                <div class="field">
                    <label for="cf-service">{f.service}</label>
                    <div class="select">
                        <select id="cf-service" name="service" required>
                            <option value="" disabled selected>{f.servicePlaceholder}</option>
                            {t.services.items.map((s) => <option value={s.name}>{s.name}</option>)}
                            <option value={f.other}>{f.other}</option>
                        </select>
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                    </div>
                </div>
                <div class="field full">
                    <label for="cf-message">{f.message}</label>
                    <textarea id="cf-message" name="message" rows="5" placeholder={f.messagePlaceholder} required></textarea>
                </div>

                <div class="captcha full">
                    <div class="h-captcha" data-captcha="true"></div>
                </div>

                <div class="submit full">
                    <p class="consent">
                        {f.consentPre} <a href={localizePath("/privacy", lang)}>{f.consentLink}</a>.
                    </p>
                    <button class="btn btn-primary" type="submit" data-label={f.submit} data-sending={f.sending}>{f.submit}</button>
                </div>
                <p class="status full" role="status" aria-live="polite" data-status hidden></p>
                <template data-success>{f.success}</template>
                <template data-captcha-missing>{f.captcha}</template>
                <template data-error>{f.error} <a href={`mailto:${site.email}`}>{site.email}</a>.</template>
            </form>
        </div>
    </div>
</section>

<script is:inline src="https://web3forms.com/client/script.js" async defer></script>

<script>
    const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
    if (form) {
        const status = form.querySelector<HTMLElement>("[data-status]")!;
        const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
        const tpl = (name: string) => (form.querySelector(`template[data-${name}]`) as HTMLTemplateElement).innerHTML;

        const show = (kind: "success" | "error" | "captcha-missing") => {
            status.hidden = false;
            status.dataset.kind = kind;
            status.innerHTML = tpl(kind);
        };

        form.addEventListener("submit", async (event) => {
            event.preventDefault();
            status.hidden = true;
            if (!form.checkValidity()) {
                form.classList.add("was-validated");
                form.querySelector<HTMLElement>(":invalid")?.focus();
                return;
            }
            const token = form.querySelector<HTMLTextAreaElement>("[name='h-captcha-response']")?.value;
            if (!token) {
                show("captcha-missing");
                return;
            }
            button.disabled = true;
            button.textContent = button.dataset.sending ?? "";
            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    headers: { Accept: "application/json" },
                    body: new FormData(form),
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok || !result.success) throw new Error(result.message ?? "Request failed");
                form.reset();
                (window as unknown as { hcaptcha?: { reset: () => void } }).hcaptcha?.reset();
                form.classList.remove("was-validated");
                show("success");
            } catch {
                show("error");
            } finally {
                button.disabled = false;
                button.textContent = button.dataset.label ?? "";
            }
        });
    }
</script>

<style>
    .contact {
        display: grid;
        gap: 3rem;
        margin-top: 2.5rem;
    }
    @media (min-width: 900px) {
        .contact {
            grid-template-columns: 4fr 8fr;
            column-gap: 4rem;
        }
    }
    .details {
        display: grid;
        align-content: start;
    }
    .details div {
        padding-block: 1rem;
        border-bottom: 1px solid var(--rule);
    }
    .details div:first-child {
        padding-top: 0;
    }
    dt {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    dd {
        margin-top: 0.25rem;
        font-size: var(--step-1);
        font-weight: 500;
        overflow-wrap: anywhere;
    }
    dd a:not(.btn) {
        text-decoration-color: var(--rule-strong);
    }
    dd a:not(.btn):hover {
        text-decoration-color: currentColor;
    }

    .form {
        display: grid;
        gap: 1.25rem 1.5rem;
        padding-top: 0;
    }
    @media (min-width: 640px) {
        .form {
            grid-template-columns: 1fr 1fr;
        }
        .full {
            grid-column: 1 / -1;
        }
    }
    .hp {
        position: absolute;
        left: -9999px;
    }
    .field {
        display: grid;
        gap: 0.4rem;
    }
    label {
        font-size: var(--step--1);
        font-weight: 600;
    }
    .opt {
        font-weight: 400;
        color: var(--ink-3);
    }
    input,
    select,
    textarea {
        width: 100%;
        background-color: var(--surface);
        min-height: 3rem;
        padding: 0.7rem 0.875rem;
        border: 1px solid var(--rule-strong);
        border-radius: var(--radius);
        font-size: var(--step-0);
        transition:
            border-color 150ms var(--ease-out),
            background-color 150ms var(--ease-out);
    }
    textarea {
        resize: vertical;
        min-height: 8rem;
    }
    ::placeholder {
        color: var(--ink-3);
        opacity: 1;
    }
    input:hover,
    select:hover,
    textarea:hover {
        border-color: var(--ink-3);
    }
    input:focus,
    select:focus,
    textarea:focus {
        outline: none;
        border-color: var(--green-ink);
        background: var(--surface);
        box-shadow: 0 0 0 3px var(--green-wash);
    }
    .was-validated :invalid {
        border-color: var(--danger);
    }
    .select {
        position: relative;
    }
    select {
        appearance: none;
        padding-right: 2.5rem;
    }
    select:invalid {
        color: var(--ink-3);
    }
    .select svg {
        position: absolute;
        right: 0.875rem;
        top: 50%;
        width: 1rem;
        height: 1rem;
        transform: translateY(-50%);
        pointer-events: none;
        color: var(--ink-3);
    }
    .submit {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 1.5rem;
        padding-top: 0.5rem;
    }
    .consent {
        font-size: var(--step--1);
        color: var(--ink-3);
        max-width: 40ch;
    }
    .status {
        padding: 0.875rem 1rem;
        border-radius: var(--radius);
        font-size: var(--step--1);
    }
    .status[data-kind="success"] {
        background: var(--green-wash);
        color: var(--green-deep);
    }
    .captcha {
        min-height: 78px;
    }
    .status[data-kind="error"],
    .status[data-kind="captcha-missing"] {
        background: #fbeceb;
        color: var(--danger);
    }
</style>
