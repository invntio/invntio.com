---
import Wordmark from "./Wordmark.astro";
import { getLang, localizePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const home = localizePath("/", lang);
const links = [
    { href: `${home}#services`, label: t.nav.services },
    { href: `${home}#work`, label: t.nav.work },
    { href: `${home}#process`, label: t.nav.process },
    { href: `${home}#contact`, label: t.nav.contact },
];
const other = lang === "en" ? "es" : "en";
const switchHref = localizePath(Astro.url.pathname, other);
---

<header class="site-header" data-header>
    <div class="wrap bar">
        <a class="brand" href={home} aria-label={t.nav.home}>
            <Wordmark class="wordmark" />
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
            <span class="sr-only">{t.nav.menu}</span>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path class="l1" d="M4 8h16" />
                <path class="l2" d="M4 16h16" />
            </svg>
        </button>

        <nav id="site-nav" class="nav" aria-label="Main">
            <ul>
                {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
            <div class="nav-end">
                <a class="lang" href={switchHref} hreflang={other} lang={other}>
                    <span class="sr-only">{t.nav.language}: </span>
                    <span aria-current={lang === "en" ? "true" : undefined} class:list={{ on: lang === "en" }}>EN</span>
                    <span aria-hidden="true" class="sep">/</span>
                    <span aria-current={lang === "es" ? "true" : undefined} class:list={{ on: lang === "es" }}>ES</span>
                </a>
                <button class="theme" type="button" data-theme-toggle aria-label={t.nav.theme} title={t.nav.theme}>
                    <svg class="orb" viewBox="0 0 20 20" aria-hidden="true">
                        <mask id="theme-cut">
                            <rect width="20" height="20" fill="#fff" />
                            <circle class="cut" cx="15" cy="5" r="4.5" fill="#000" />
                        </mask>
                        <circle class="body" cx="10" cy="10" r="4" fill="currentColor" mask="url(#theme-cut)" />
                        <g class="rays" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                            <path d="M10 1.75v1.5M10 16.75v1.5M1.75 10h1.5M16.75 10h1.5M4.2 4.2l1.05 1.05M14.75 14.75l1.05 1.05M4.2 15.8l1.05-1.05M14.75 5.25l1.05-1.05" />
                        </g>
                    </svg>
                </button>
                <a class="btn btn-primary cta" href={`${home}#contact`}>{t.nav.cta}</a>
            </div>
        </nav>
    </div>
</header>

<script>
    const header = document.querySelector<HTMLElement>("[data-header]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    // On the home page the logo scrolls back to the top instead of reloading.
    document.querySelectorAll<HTMLAnchorElement>("a.brand").forEach((link) =>
        link.addEventListener("click", (event) => {
            const target = new URL(link.href);
            if (target.pathname.replace(/\/$/, "") !== location.pathname.replace(/\/$/, "")) return;
            event.preventDefault();
            window.scrollTo({ top: 0, behavior: "smooth" });
            history.replaceState(null, "", target.pathname);
        }),
    );

    const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
    themeToggle?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        const apply = () => {
            root.dataset.theme = next;
            try {
                localStorage.setItem("invntio-theme", next);
            } catch {
                /* choice lasts for this page view only */
            }
        };
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (!document.startViewTransition || reduce) return apply();

        // The new theme spreads as a circle from the button, like ink over the sheet.
        const r = themeToggle.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        const transition = document.startViewTransition(apply);
        transition.finished.catch(() => {});
        transition.ready.then(() => {
            root.animate(
                { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
                { duration: 650, easing: "cubic-bezier(0.16, 1, 0.3, 1)", pseudoElement: "::view-transition-new(root)" },
            );
        }).catch(() => {});
    });

    if (header && toggle) {
        const setOpen = (open: boolean) => {
            toggle.setAttribute("aria-expanded", String(open));
            header.classList.toggle("is-open", open);
        };
        toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
        header.querySelectorAll(".nav a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && header.classList.contains("is-open")) {
                setOpen(false);
                toggle.focus();
            }
        });
        const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
    }
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--ground) 92%, transparent);
        backdrop-filter: saturate(1.4) blur(10px);
        border-bottom: 1px solid transparent;
        transition: border-color 200ms var(--ease-out);
    }
    .site-header.is-scrolled,
    .site-header.is-open {
        border-bottom-color: var(--rule);
    }
    .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 4.25rem;
    }
    .brand {
        display: inline-flex;
        color: var(--ink);
        padding-block: 0.5rem;
    }
    .brand :global(.wordmark) {
        height: 1.375rem;
        width: auto;
    }
    .nav {
        display: flex;
        align-items: center;
        gap: 2rem;
    }
    .nav ul {
        display: flex;
        gap: 1.75rem;
        padding: 0;
        list-style: none;
    }
    .nav ul a {
        color: var(--ink-2);
        text-decoration: none;
        font-size: var(--step--1);
        font-weight: 500;
        padding-block: 0.5rem;
        transition: color 150ms var(--ease-out);
    }
    .nav ul a:hover {
        color: var(--ink);
    }
    .nav-end {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }
    .lang {
        display: inline-flex;
        gap: 0.3rem;
        font-size: var(--step--1);
        color: var(--ink-3);
        text-decoration: none;
        padding: 0.5rem 0.25rem;
    }
    .lang .on {
        color: var(--ink);
        font-weight: 600;
    }
    .lang:hover span:not(.on):not(.sep) {
        color: var(--ink);
        text-decoration: underline;
    }
    .theme {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--rule-strong);
        border-radius: var(--radius);
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
        transition:
            color 150ms var(--ease-out),
            border-color 150ms var(--ease-out);
    }
    .theme:hover {
        color: var(--ink);
        border-color: var(--ink);
    }
    .theme svg {
        width: 1.25rem;
        height: 1.25rem;
        overflow: visible;
    }
    /* Sun in light, moon in dark: the bite slides in and the rays fold away. */
    .orb .body,
    .orb .cut,
    .orb .rays {
        transition:
            transform 500ms var(--ease-out),
            opacity 300ms var(--ease-out);
        transform-origin: 10px 10px;
    }
    .orb .cut {
        transform: translate(8px, -8px);
    }
    :global([data-theme="dark"]) .orb .body {
        transform: scale(1.55);
    }
    :global([data-theme="dark"]) .orb .cut {
        transform: translate(-1px, 1px);
    }
    :global([data-theme="dark"]) .orb .rays {
        transform: rotate(-45deg) scale(0.4);
        opacity: 0;
    }
    .cta {
        min-height: 2.5rem;
        padding: 0.5rem 1rem;
        font-size: var(--step--1);
    }
    .menu-toggle {
        display: none;
        border: 0;
        background: none;
        padding: 0.625rem;
        margin-right: -0.625rem;
        cursor: pointer;
    }
    .menu-toggle path {
        transition: transform 220ms var(--ease-out);
        transform-origin: center;
    }
    .is-open .menu-toggle .l1 {
        transform: translateY(4px) rotate(45deg);
    }
    .is-open .menu-toggle .l2 {
        transform: translateY(-4px) rotate(-45deg);
    }

    @media (max-width: 859px) {
        .menu-toggle {
            display: block;
        }
        .nav {
            position: absolute;
            inset: 100% 0 auto 0;
            flex-direction: column;
            align-items: stretch;
            gap: 1.5rem;
            padding: 1rem var(--gutter) 1.75rem;
            background: var(--ground);
            border-bottom: 1px solid var(--rule);
            visibility: hidden;
            opacity: 0;
            transform: translateY(-0.5rem);
            transition:
                opacity 200ms var(--ease-out),
                transform 200ms var(--ease-out),
                visibility 0s linear 200ms;
        }
        .is-open .nav {
            visibility: visible;
            opacity: 1;
            transform: none;
            transition:
                opacity 200ms var(--ease-out),
                transform 200ms var(--ease-out);
        }
        .nav ul {
            flex-direction: column;
            gap: 0;
        }
        .nav ul a {
            display: block;
            padding-block: 0.875rem;
            border-bottom: 1px solid var(--rule);
            font-size: var(--step-1);
            color: var(--ink);
        }
        .nav-end {
            justify-content: space-between;
        }
    }
</style>
