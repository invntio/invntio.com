---
import Mark from "./Mark.astro";
import { getLang, useTranslations } from "../i18n/ui";
import { site } from "../config/site";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
    <div class="wrap hero-grid">
        <div class="pitch">
            <h1>{t.hero.title}</h1>
            <p class="lede">{t.hero.lede}</p>
            <div class="actions">
                <a class="btn btn-primary" href="#contact">
                    {t.hero.cta}
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
                </a>
                <p class="or">
                    {t.hero.orEmail} <a href={`mailto:${site.email}`}>{site.email}</a>
                </p>
            </div>
            <p class="where">{t.hero.location}</p>
        </div>

        <div class="register" id="work">
            <div class="register-head">
                <h2><Mark kind="live" /> {t.register.title}</h2>
                <p>{t.register.caption}</p>
            </div>
            <ol class="rows">
                {t.register.items.map((item) => (
                    <li>
                        <a class="row" href={item.url} target="_blank" rel="noopener">
                            <span class="name">{item.name}</span>
                            <span class="kind">{item.kind === "own" ? t.register.ownProduct : t.register.client}</span>
                            <span class="what">{item.what}</span>
                            <span class="domain">
                                {item.domain}
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" /></svg>
                            </span>
                        </a>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>

<style>
    .hero {
        padding-block: clamp(3rem, 2rem + 5vw, 7rem) 0;
    }
    .hero-grid {
        display: grid;
        gap: 3.5rem;
    }
    @media (min-width: 1000px) {
        .hero-grid {
            grid-template-columns: 7fr 5fr;
            gap: 4rem;
            align-items: end;
        }
    }
    h1 {
        font-size: var(--step-4);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.02;
        max-width: 14ch;
    }
    .lede {
        margin-top: 1.75rem;
        font-size: var(--step-1);
        color: var(--ink-2);
        max-width: 50ch;
    }
    .actions {
        margin-top: 2.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.5rem;
    }
    .or {
        color: var(--ink-3);
        font-size: var(--step--1);
    }
    .or a {
        color: var(--ink);
        font-weight: 500;
        overflow-wrap: anywhere;
    }
    .where {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-size: var(--step--1);
        color: var(--ink-3);
    }

    .register {
        border-top: 1px solid var(--ink);
        scroll-margin-top: 6rem;
    }
    .register-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.25rem 1rem;
        padding-block: 0.875rem;
        border-bottom: 1px solid var(--rule);
    }
    .register-head h2 {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--step-0);
        font-weight: 650;
        letter-spacing: 0;
    }
    .register-head p {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .rows {
        list-style: none;
        padding: 0;
    }
    .rows li {
        border-bottom: 1px solid var(--rule);
    }
    .row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 0.25rem 1rem;
        padding: 1.125rem 0.75rem;
        margin-inline: -0.75rem;
        text-decoration: none;
        border-radius: var(--radius);
        transition: background-color 200ms var(--ease-out);
    }
    .name {
        font-size: var(--step-1);
        font-weight: 650;
        letter-spacing: -0.01em;
    }
    .kind {
        justify-self: end;
        align-self: center;
        font-size: 0.8125rem;
        color: var(--ink-3);
    }
    .what {
        color: var(--ink-2);
        font-size: var(--step--1);
    }
    .domain {
        justify-self: end;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: var(--step--1);
        color: var(--green-ink);
        font-weight: 500;
        white-space: nowrap;
    }
    .domain svg {
        width: 0.875rem;
        height: 0.875rem;
        transition: transform 220ms var(--ease-out);
    }
    .row:hover,
    .row:focus-visible {
        background: var(--surface);
    }
    .row:hover .domain svg,
    .row:focus-visible .domain svg {
        transform: translate(2px, -2px);
    }

    /* Wide screens: domains stay quiet until the row is engaged. */
    @media (hover: hover) and (min-width: 1000px) {
        .domain {
            color: var(--ink-3);
            transition: color 200ms var(--ease-out);
        }
        .row:hover .domain,
        .row:focus-visible .domain {
            color: var(--green-ink);
        }
    }

    @media (max-width: 480px) {
        .row {
            grid-template-columns: 1fr;
        }
        .kind,
        .domain {
            justify-self: start;
        }
        .kind {
            order: 3;
        }
    }
</style>
