---
import Mark from "./Mark.astro";
import Dotted from "./Dotted.astro";
import { getLang, useTranslations } from "../i18n/ui";
import { site } from "../config/site";

const lang = getLang(Astro.url);
const t = useTranslations(lang);

// Sparkles burst from the headline's closing dot: a nod to the old "Unleash" sparkle and to the dot in the wordmark.
const sparks = Array.from({ length: 12 }, (_, i) => {
    const angle = (-160 + i * (140 / 11)) * (Math.PI / 180);
    const dist = 0.6 + ((i * 7) % 5) * 0.18;
    return {
        x: +(Math.cos(angle) * dist).toFixed(3),
        y: +(Math.sin(angle) * dist).toFixed(3),
        s: +(0.55 + ((i * 3) % 4) * 0.15).toFixed(2),
        d: +(((i * 5) % 12) * 0.09).toFixed(2),
    };
});
---

<section class="hero">
    <div class="wrap hero-grid">
        <div class="pitch">
            <h1 data-spark-title>
                <Dotted text={t.hero.title.replace(/\.$/, "")} /><span class="spark-dot">.<span class="sparks" aria-hidden="true">
                    {sparks.map((p) => (
                        <svg style={`--x:${p.x}em;--y:${p.y}em;--s:${p.s};--d:${p.d}s`} viewBox="0 0 10 10"><path d="M5 0l1.1 3.9L10 5 6.1 6.1 5 10 3.9 6.1 0 5l3.9-1.1z" /></svg>
                    ))}
                </span></span>
            </h1>
            <p class="lede">{t.hero.lede}</p>
            <div class="actions">
                <a class="btn btn-primary" href="#contact">
                    {t.hero.cta}
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
                </a>
                <p class="or">
                    {t.hero.orEmail} <a href={`mailto:${site.email}`}>{site.email}</a>
                </p>
            </div>
        </div>

        <div class="register" id="work">
            <div class="register-head" data-reveal>
                <h2><Mark kind="live" /> {t.register.title}</h2>
                <p>{t.register.caption}</p>
            </div>
            <ol class="rows">
                {t.register.items.filter((item) => !item.hidden).map((item, i) => (
                    <li data-reveal style={`--stagger:${i + 1}`}>
                        <a class="row" href={item.url} target="_blank" rel="noopener">
                            <span class="dot"><Mark kind="live" label={t.register.live} /></span>
                            <span class="name">{item.name} <span class="kind">{item.kind === "own" ? t.register.ownProduct : t.register.client}</span></span>
                            <span class="what">{item.what}</span>
                            <span class="domain">
                                {item.domain}
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" /></svg>
                            </span>
                        </a>
                    </li>
                ))}
            </ol>
        </div>
    </div>
</section>

<script>
    // Replay the sparkle burst when the headline is hovered.
    const title = document.querySelector("[data-spark-title]");
    let last = 0;
    title?.addEventListener("mouseenter", () => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches || performance.now() - last < 1800) return;
        last = performance.now();
        title.querySelectorAll(".sparks svg").forEach((el) =>
            el.getAnimations().forEach((anim) => {
                anim.cancel();
                anim.play();
            }),
        );
    });
</script>

<style>
    .hero {
        padding-block: clamp(3rem, 2rem + 5vw, 7rem) 0;
    }
    .hero-grid {
        display: grid;
        gap: 3.5rem;
    }
    @media (min-width: 1000px) {
        .hero-grid {
            grid-template-columns: 7fr 5fr;
            gap: 4rem;
            align-items: start;
        }
        .register {
            margin-top: 0.75rem;
        }
    }
    h1 {
        font-size: var(--step-4);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.02;
        max-width: 14ch;
    }
    .lede {
        margin-top: 1.75rem;
        font-size: var(--step-1);
        color: var(--ink-2);
        max-width: 50ch;
    }
    .actions {
        margin-top: 2.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.5rem;
    }
    .or {
        color: var(--ink-3);
        font-size: var(--step--1);
    }
    .or a {
        color: var(--ink);
        font-weight: 500;
        overflow-wrap: anywhere;
    }
    .spark-dot {
        position: relative;
        color: var(--green);
    }
    .sparks {
        position: absolute;
        left: 0.14em;
        bottom: 0.14em;
        width: 0;
        height: 0;
        pointer-events: none;
    }
    .sparks svg {
        position: absolute;
        left: -0.13em;
        top: -0.13em;
        width: 0.26em;
        height: 0.26em;
        max-width: none;
        fill: var(--green);
        opacity: 0;
        transform: translate(0, 0) scale(0);
    }
    @media (prefers-reduced-motion: no-preference) {
        .sparks svg {
            animation: spark 1.6s var(--ease-out) var(--d) 2 both;
        }
    }
    @keyframes spark {
        0% {
            opacity: 0;
            transform: translate(0, 0) scale(0) rotate(0deg);
        }
        20% {
            opacity: 1;
        }
        100% {
            opacity: 0;
            transform: translate(var(--x), var(--y)) scale(var(--s)) rotate(90deg);
        }
    }

    .register {
        border-top: 1px solid var(--ink);
        scroll-margin-top: 6rem;
    }
    .register-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.25rem 1rem;
        padding-block: 0.875rem;
        border-bottom: 1px solid var(--rule);
    }
    .register-head h2 {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--step-0);
        font-weight: 650;
        letter-spacing: 0;
    }
    .register-head p {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .rows {
        list-style: none;
        padding: 0;
    }
    .rows li {
        border-bottom: 1px solid var(--rule);
    }
    .row {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.25rem 1rem;
        padding: 1.125rem 0.75rem 1.125rem 2.35rem;
        margin-inline: -0.75rem;
        text-decoration: none;
        border-radius: var(--radius);
        transition: background-color 200ms var(--ease-out);
    }
    .dot {
        position: absolute;
        left: 0.75rem;
        top: 1.125rem;
        height: 1.75rem;
        display: flex;
        align-items: center;
    }
    .name {
        grid-column: 1 / -1;
        font-size: var(--step-1);
        font-weight: 650;
        letter-spacing: -0.01em;
    }
    .kind {
        margin-left: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 400;
        letter-spacing: 0;
        color: var(--ink-3);
    }
    .what {
        color: var(--ink-2);
        font-size: var(--step--1);
    }
    .domain {
        justify-self: end;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: var(--step--1);
        color: var(--green-ink);
        font-weight: 500;
        white-space: nowrap;
    }
    .domain svg {
        width: 0.875rem;
        height: 0.875rem;
        transition: transform 220ms var(--ease-out);
    }
    .row:hover,
    .row:focus-visible {
        background: var(--surface);
    }
    .row:hover .domain svg,
    .row:focus-visible .domain svg {
        transform: translate(2px, -2px);
    }

    /* Wide screens: domains stay quiet until the row is engaged. */
    @media (hover: hover) and (min-width: 1000px) {
        .domain {
            color: var(--ink-3);
            transition: color 200ms var(--ease-out);
        }
        .row:hover .domain,
        .row:focus-visible .domain {
            color: var(--green-ink);
        }
    }

    @media (max-width: 480px) {
        .row {
            grid-template-columns: 1fr;
        }
        .domain {
            justify-self: start;
        }
    }
</style>
