---
import Dotted from "./Dotted.astro";
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getLang, localizePath, useTranslations } from "../i18n/ui";
import { site } from "../config/site";

interface Props {
    slug: "terms" | "refunds" | "privacy";
}

const lang = getLang(Astro.url);
const t = useTranslations(lang);
const entry = await getEntry("legal", `${lang}/${Astro.props.slug}`);
if (!entry) throw new Error(`Missing legal page ${lang}/${Astro.props.slug}`);

const tokens: Record<string, string> = {
    email: `<a href="mailto:${site.email}">${site.email}</a>`,
    operator: site.operator,
    location: site.location[lang],
};
const html = (entry.rendered?.html ?? "").replace(/\{\{(\w+)\}\}/g, (_, key) => tokens[key] ?? "");
type Heading = { depth: number; slug: string; text: string };
const headings = ((entry.rendered?.metadata?.headings ?? []) as Heading[]).filter((h) => h.depth === 2);
const updated = new Intl.DateTimeFormat(lang === "es" ? "es" : "en-US", { dateStyle: "long", timeZone: "UTC" }).format(entry.data.updated);
const siblings = (["terms", "refunds", "privacy"] as const).map((slug) => ({
    slug,
    href: localizePath(`/${slug}`, lang),
    label: t.footer[slug],
}));
---

<Layout title={entry.data.title} description={entry.data.description} updated={entry.data.updated}>
    <article class="wrap legal">
        <header class="legal-head">
            <nav class="docs" aria-label={t.footer.legal}>
                {siblings.map((s) => (
                    <a href={s.href} aria-current={s.slug === Astro.props.slug ? "page" : undefined}>{s.label}</a>
                ))}
            </nav>
            <h1><Dotted text={entry.data.title} /></h1>
            <p class="updated">{t.legal.updated}: <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{updated}</time></p>
        </header>

        <div class="legal-body">
            {headings.length > 3 && (
                <aside class="toc" aria-labelledby="toc-title">
                    <h2 id="toc-title">{t.legal.onThisPage}</h2>
                    <ol>
                        {headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
                    </ol>
                </aside>
            )}
            <div class="prose" set:html={html} />
        </div>
    </article>
</Layout>

<script>
    // Highlight the section being read in the table of contents.
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>(".toc a").forEach((a) => links.set(decodeURIComponent(a.hash.slice(1)), a));
    const headings = [...document.querySelectorAll<HTMLElement>(".prose h2[id]")];
    if (links.size && headings.length) {
        const setActive = (id: string) =>
            links.forEach((a, key) => (key === id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
        const update = () => {
            // The active section is the last heading above a line 30% down the viewport.
            const line = window.innerHeight * 0.3;
            let current = headings[0];
            for (const h of headings) {
                if (h.getBoundingClientRect().top <= line) current = h;
                else break;
            }
            // At the very bottom, the last section wins even if its heading never reaches the line.
            if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) current = headings[headings.length - 1];
            setActive(current.id);
        };
        let ticking = false;
        window.addEventListener(
            "scroll",
            () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                    update();
                    ticking = false;
                });
            },
            { passive: true },
        );
        update();
        window.addEventListener("load", update);
        window.addEventListener("hashchange", () => requestAnimationFrame(update));
    }
</script>

<style>
    .legal {
        padding-top: clamp(2.5rem, 2rem + 3vw, 5rem);
    }
    .legal-head {
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--ink);
    }
    .docs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-bottom: 2.5rem;
        font-size: var(--step--1);
    }
    .docs a {
        color: var(--ink-3);
        text-decoration: none;
        padding-block: 0.25rem;
        border-bottom: 1px solid transparent;
    }
    .docs a:hover {
        color: var(--ink);
    }
    .docs a[aria-current="page"] {
        color: var(--ink);
        font-weight: 600;
        border-bottom-color: var(--ink);
    }
    h1 {
        font-size: var(--step-4);
        letter-spacing: -0.035em;
        max-width: 18ch;
    }
    .updated {
        margin-top: 1rem;
        color: var(--ink-3);
        font-size: var(--step--1);
    }
    .legal-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        padding-top: 2.5rem;
    }
    @media (min-width: 1000px) {
        .legal-body {
            grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
            column-gap: 4rem;
        }
        .toc {
            position: sticky;
            top: 6rem;
            align-self: start;
            max-height: calc(100vh - 8rem);
            overflow: auto;
        }
    }
    .toc h2 {
        font-size: var(--step--1);
        font-weight: 600;
        letter-spacing: 0;
        margin-bottom: 0.75rem;
    }
    .toc ol {
        list-style: none;
        padding: 0;
        display: grid;
        gap: 0.125rem;
        font-size: var(--step--1);
    }
    .toc a {
        position: relative;
        display: block;
        padding: 0.3rem 0 0.3rem 1rem;
        color: var(--ink-3);
        text-decoration: none;
        transition: color 200ms var(--ease-out);
    }
    .toc a::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.85em;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--green);
        transform: scale(0);
        transition: transform 250ms var(--ease-out);
    }
    .toc a[aria-current="true"] {
        color: var(--ink);
        font-weight: 500;
    }
    .toc a[aria-current="true"]::before {
        transform: scale(1);
    }
    .toc a:hover {
        color: var(--ink);
    }
    @media (max-width: 999px) {
        .toc {
            padding-bottom: 1.25rem;
            border-bottom: 1px solid var(--rule);
        }
    }

    .prose {
        max-width: 68ch;
        color: var(--ink-2);
    }
    .prose :global(h2) {
        margin-top: 3rem;
        margin-bottom: 1rem;
        font-size: var(--step-2);
        color: var(--ink);
        scroll-margin-top: 6rem;
    }
    .prose :global(h2:first-child) {
        margin-top: 0;
    }
    .prose :global(p),
    .prose :global(ul),
    .prose :global(ol) {
        margin-block: 0 1rem;
    }
    .prose > :global(p:first-child) {
        font-size: var(--step-1);
        color: var(--ink);
    }
    .prose :global(ul) {
        padding-left: 1.25rem;
    }
    .prose :global(li) {
        margin-bottom: 0.5rem;
        padding-left: 0.25rem;
    }
    .prose :global(li::marker) {
        color: var(--ink-3);
    }
    .prose :global(strong) {
        color: var(--ink);
        font-weight: 600;
    }
    .prose :global(a) {
        color: var(--green-ink);
    }
    .prose :global(code) {
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        font-size: 0.85em;
        padding: 0.1em 0.35em;
        border: 1px solid var(--rule);
        border-radius: 4px;
        color: var(--ink);
        white-space: nowrap;
    }
    .prose :global(table) {
        width: 100%;
        margin-block: 1.5rem 2.5rem;
        border-collapse: collapse;
        font-size: var(--step--1);
    }
    .prose :global(th),
    .prose :global(td) {
        text-align: left;
        vertical-align: top;
        padding: 0.875rem 1rem 0.875rem 0;
        border-bottom: 1px solid var(--rule);
    }
    .prose :global(th) {
        color: var(--ink);
        font-weight: 600;
        border-bottom-color: var(--ink);
    }
    .prose :global(td:first-child) {
        color: var(--ink);
        font-weight: 600;
    }
    @media print {
        .legal {
            padding-top: 0;
        }
        .legal-body {
            display: block;
            padding-top: 1.5rem;
        }
        h1 {
            font-size: 26pt;
            max-width: none;
        }
        .prose {
            max-width: none;
            color: #1f2328;
        }
        .prose :global(h2) {
            font-size: 14pt;
            margin-top: 1.5rem;
        }
        .prose > :global(p:first-child) {
            font-size: 11.5pt;
        }
    }
    @media (max-width: 700px) {
        .prose :global(thead) {
            display: none;
        }
        .prose :global(tr) {
            display: grid;
            padding-block: 0.875rem;
            border-bottom: 1px solid var(--rule);
        }
        .prose :global(td) {
            border: 0;
            padding: 0.125rem 0;
        }
    }
</style>
