---
import type { Mark as MarkKind } from "../i18n/ui";

interface Props {
    kind: MarkKind;
    label?: string;
}

const { kind, label } = Astro.props;
---

<svg
    class={`mark mark-${kind}`}
    viewBox="0 0 16 16"
    width="16"
    height="16"
    role={label ? "img" : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : "true"}
>
    {kind === "live" && <>
        <circle class="halo" cx="8" cy="8" r="7" />
        <circle cx="8" cy="8" r="4" />
    </>}
    {kind === "included" && <path d="M3.5 8.5l3 3 6-7" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />}
    {kind === "excluded" && <circle cx="8" cy="8" r="4.25" fill="none" stroke-width="1.5" />}
</svg>

<style>
    .mark {
        flex: none;
        width: 1em;
        height: 1em;
    }
    .mark-live circle {
        fill: var(--green);
    }
    .mark-live .halo {
        fill: var(--green);
        opacity: 0.2;
    }
    .mark-included path {
        stroke: var(--green-ink);
    }
    .mark-excluded circle {
        stroke: var(--ink-3);
    }
</style>
