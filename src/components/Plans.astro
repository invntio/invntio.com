---
import Dotted from "./Dotted.astro";
import Mark from "./Mark.astro";
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="plans" id="plans" aria-labelledby="plans-title">
    <div class="intro" data-reveal>
        <h2 id="plans-title"><Dotted text={t.plans.title} period /></h2>
        <p>{t.plans.lede}</p>
    </div>

    <div class="body">
        <ul class="tiers">
            {t.plans.tiers.map((tier, i) => (
                <li class="tier" data-reveal style={`--stagger:${i + 1}`}>
                    <h3>{tier.name}</h3>
                    <p class="price">{tier.price}<span class="period">{tier.period}</span></p>
                    <p class="yearly">{tier.yearly}</p>
                    <p class="lead">{tier.lead}</p>
                    <ul class="items">
                        {tier.items.map((item) => <li><Mark kind="included" />{item}</li>)}
                    </ul>
                </li>
            ))}
        </ul>

        <ul class="points" data-reveal style="--stagger:3">
            {t.plans.billing.map((line) => <li><Mark kind="included" />{line}</li>)}
        </ul>

        <details class="excluded" data-collapse data-reveal style="--stagger:4">
            <summary>
                {t.plans.excludedTitle}
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path class="v" d="M8 3v10" /><path d="M3 8h10" /></svg>
            </summary>
            <div data-panel>
                <ul>
                    {t.plans.excluded.map((item) => <li><Mark kind="excluded" />{item}</li>)}
                </ul>
                <p class="note">{t.plans.note}</p>
            </div>
        </details>
    </div>
</section>

<style>
    .plans {
        display: grid;
        gap: 1.75rem 4rem;
        padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
        border-top: 1px solid var(--ink);
        scroll-margin-top: 6rem;
    }
    @media (min-width: 900px) {
        .plans {
            grid-template-columns: 5fr 7fr;
        }
    }
    h2 {
        font-size: var(--step-3);
        max-width: 16ch;
    }
    .intro p {
        margin-top: 1rem;
        color: var(--ink-2);
        max-width: 38ch;
    }
    .tiers,
    .items,
    .points,
    .excluded ul {
        list-style: none;
        padding: 0;
    }

    /* Two plans side by side, each a ruled card; the second only lists what it adds. */
    .tiers {
        display: grid;
        gap: 1rem;
    }
    @media (min-width: 640px) {
        .tiers {
            grid-template-columns: 1fr 1fr;
        }
    }
    .tier {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        border: 1px solid var(--rule);
        border-radius: var(--radius, 12px);
        transition:
            border-color 200ms var(--ease-out),
            transform 200ms var(--ease-out);
    }
    .tier:hover {
        border-color: var(--rule-strong);
        transform: translateY(-2px);
    }
    h3 {
        font-size: var(--step-0);
        font-weight: 600;
    }
    .price {
        margin-top: 0.75rem;
        font-size: var(--step-3);
        font-weight: 600;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        letter-spacing: -0.02em;
    }
    .period {
        font-size: var(--step-0);
        font-weight: 400;
        color: var(--ink-2);
        letter-spacing: 0;
    }
    .yearly {
        margin-top: 0.375rem;
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .lead {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--rule);
        font-size: var(--step--1);
        font-weight: 600;
    }
    .items li,
    .points li,
    .excluded li {
        display: flex;
        gap: 0.625rem;
        align-items: baseline;
        font-size: var(--step--1);
    }
    .items li {
        margin-top: 0.625rem;
        color: var(--ink-2);
    }
    .items :global(.mark),
    .points :global(.mark),
    .excluded :global(.mark) {
        position: relative;
        top: 0.15em;
        flex: none;
    }

    /* The three promises that matter most, on one line where it fits. */
    .points {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.75rem;
        margin-top: 1.5rem;
    }

    /* What plans leave out stays one click away, so the page doesn't read as fine print. */
    .excluded {
        margin-top: 1.5rem;
        border-top: 1px solid var(--rule);
    }
    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 1rem;
        font-size: var(--step--1);
        font-weight: 600;
        cursor: pointer;
        list-style: none;
    }
    summary::-webkit-details-marker {
        display: none;
    }
    summary svg {
        flex: none;
        width: 1rem;
        height: 1rem;
        color: var(--ink-3);
        transition: color 150ms var(--ease-out);
    }
    summary:hover svg {
        color: var(--ink);
    }
    summary .v {
        transform-box: fill-box;
        transform-origin: center;
        transition: transform 200ms var(--ease-out);
    }
    .excluded[open]:not(.closing) summary .v {
        transform: rotate(90deg);
    }
    .excluded ul {
        display: grid;
        gap: 0.5rem 2rem;
    }
    @media (min-width: 640px) {
        .excluded ul {
            grid-template-columns: 1fr 1fr;
        }
    }
    .excluded li {
        color: var(--ink-2);
    }
    .note {
        margin-top: 1rem;
        padding-bottom: 1rem;
        font-size: var(--step--1);
        color: var(--ink-3);
        max-width: 62ch;
    }

    @media (prefers-reduced-motion: reduce) {
        .tier,
        summary .v {
            transition: none;
        }
        .tier:hover {
            transform: none;
        }
    }
</style>
