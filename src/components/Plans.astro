---
import Dotted from "./Dotted.astro";
import Mark from "./Mark.astro";
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="plans" id="plans" aria-labelledby="plans-title" data-reveal>
    <div class="plans-intro">
        <h2 id="plans-title"><Dotted text={t.plans.title} /></h2>
        <p>{t.plans.lede}</p>
    </div>
    <div class="plan-cols">
        <div class="compare-wrap">
            <table class="compare">
                <thead>
                    <tr>
                        <th scope="col"><span class="sr-only">{t.plans.link}</span></th>
                        {t.plans.tiers.map((tier) => (
                            <th scope="col">
                                <span class="tier-name">{tier.name}</span>
                                <span class="tier-price">{tier.price}<span class="tier-period">{tier.period}</span></span>
                                <span class="tier-yearly">{tier.yearly}</span>
                            </th>
                        ))}
                    </tr>
                </thead>
                <tbody>
                    {t.plans.rows.map((row) => (
                        <tr>
                            <th scope="row">{row.label}</th>
                            {row.values.map((v) => (
                                <td>{v === true ? <Mark kind="included" /> : v === false ? <span class="dash" aria-label="—">—</span> : v}</td>
                            ))}
                        </tr>
                    ))}
                </tbody>
            </table>
            <ul class="billing">
                {t.plans.billing.map((line) => <li><Mark kind="included" />{line}</li>)}
            </ul>
        </div>
        <div>
            <h4>{t.plans.excludedTitle}</h4>
            <ul class="checklist muted">
                {t.plans.excluded.map((item) => <li><Mark kind="excluded" />{item}</li>)}
            </ul>
        </div>
    </div>
    <p class="note">{t.plans.note}</p>
</section>

<style>
    .plans {
        scroll-margin-top: 6rem;
    }
    .plans {
        display: grid;
        gap: 2.5rem;
        padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
        border-top: 1px solid var(--ink);
    }
    @media (min-width: 900px) {
        .plans {
            grid-template-columns: 5fr 7fr;
            column-gap: 4rem;
        }
        .note {
            grid-column: 2;
        }
    }
    .plans-intro h2 {
        font-size: var(--step-2);
        font-weight: 600;
    }
    .plans-intro p {
        margin-top: 0.875rem;
        color: var(--ink-2);
        max-width: 42ch;
    }
    .plan-cols {
        display: grid;
        gap: 2.5rem;
    }
    @media (min-width: 640px) {
        .plan-cols .checklist {
            columns: 2;
            column-gap: 2rem;
        }
        .plan-cols .checklist li {
            break-inside: avoid;
        }
    }
    .compare {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--step--1);
    }
    .compare thead th {
        text-align: left;
        vertical-align: bottom;
        padding: 0 0.75rem 0.75rem 0;
        border-bottom: 1px solid var(--ink);
        font-weight: 600;
    }
    .tier-name {
        display: block;
    }
    .tier-price {
        display: block;
        margin-top: 0.25rem;
        font-size: var(--step-1);
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    @media (max-width: 520px) {
        .tier-price {
            font-size: var(--step-0);
        }
        .compare tbody th {
            width: 36%;
        }
        .compare td {
            width: 32%;
        }
    }
    .tier-period {
        font-size: var(--step--1);
        font-weight: 400;
        color: var(--ink-2);
    }
    .compare tbody th,
    .compare td {
        padding: 0.625rem 0.75rem 0.625rem 0;
        border-bottom: 1px solid var(--rule);
        text-align: left;
        vertical-align: top;
    }
    .compare tbody th {
        font-weight: 400;
        width: 40%;
    }
    .compare td {
        color: var(--ink-2);
        width: 30%;
    }
    .compare td :global(.mark) {
        position: relative;
        top: 0.15em;
    }
    .dash {
        color: var(--ink-3);
    }
    .tier-yearly {
        display: block;
        margin-top: 0.125rem;
        font-size: var(--step--2, 0.75rem);
        font-weight: 400;
        color: var(--ink-3);
    }
    .billing {
        list-style: none;
        padding: 0;
        margin-top: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
        font-size: var(--step--1);
    }
    .billing li {
        display: flex;
        gap: 0.625rem;
        align-items: baseline;
    }
    .billing :global(.mark) {
        position: relative;
        top: 0.15em;
    }
    h4 {
        font-size: var(--step--1);
        font-weight: 600;
        padding-bottom: 0.75rem;
        margin-bottom: 0.25rem;
        border-bottom: 1px solid var(--ink);
    }
    .checklist {
        list-style: none;
        padding: 0;
    }
    .checklist li {
        display: flex;
        gap: 0.75rem;
        align-items: baseline;
        padding-block: 0.625rem;
        border-bottom: 1px solid var(--rule);
        font-size: var(--step--1);
    }
    .checklist :global(.mark) {
        position: relative;
        top: 0.15em;
    }
    .checklist.muted li {
        color: var(--ink-2);
    }
    .note {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
</style>
