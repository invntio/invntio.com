---
import Dotted from "./Dotted.astro";
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="section" id="process" aria-labelledby="process-title">
    <div class="wrap">
        <div class="section-head" data-reveal>
            <h2 id="process-title"><Dotted text={t.process.title} period /></h2>
            <p>{t.process.lede}</p>
        </div>

        <ol class="rail" data-rail data-reveal>
            {t.process.steps.map((step, i) => (
                <li class="stage" style={`--i:${i}`}>
                    <span class="node" aria-hidden="true"><span>{i + 1}</span></span>
                    <h3><span class="sr-only">{i + 1}. </span>{step.name}</h3>
                    <p>{step.body}</p>
                </li>
            ))}
        </ol>
        <p class="payments" data-reveal>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="7" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 015 0v2" /></svg>
            {t.process.payments}
        </p>
    </div>
</section>

<script>
    // Measure the track from the first node's centre to the last one's, in either orientation.
    const rail = document.querySelector<HTMLElement>("[data-rail]");
    if (rail) {
        const measure = () => {
            const nodes = rail.querySelectorAll<HTMLElement>(".node");
            const box = rail.getBoundingClientRect();
            const a = nodes[0].getBoundingClientRect();
            const b = nodes[nodes.length - 1].getBoundingClientRect();
            const x0 = a.left + a.width / 2 - box.left;
            const y0 = a.top + a.height / 2 - box.top;
            const len = Math.max(b.left - a.left, b.top - a.top);
            rail.style.setProperty("--x0", `${x0}px`);
            rail.style.setProperty("--y0", `${y0}px`);
            rail.style.setProperty("--len", `${len}px`);
        };
        measure();
        new ResizeObserver(measure).observe(rail);
    }
</script>

<style>
    .rail {
        --node: 2.25rem;
        --x0: calc(var(--node) / 2);
        --y0: calc(var(--node) / 2);
        --len: 0px;
        list-style: none;
        padding: 0;
        margin-top: 2.5rem;
        display: grid;
        gap: 0;
        position: relative;
    }
    /* One continuous track through every node; the fill runs along it once. */
    .rail::before,
    .rail::after {
        content: "";
        position: absolute;
        left: var(--x0);
        top: var(--y0);
        width: 1px;
        height: var(--len);
        background: var(--rule-strong);
        transform-origin: top;
    }
    .rail::after {
        width: 2px;
        margin-left: -0.5px;
        background: var(--green);
    }
    .stage {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: var(--node) minmax(0, 1fr);
        column-gap: 1.25rem;
        row-gap: 0.5rem;
        padding-bottom: 2.25rem;
    }
    .stage:last-child {
        padding-bottom: 0;
    }
    .node {
        grid-row: span 2;
        display: grid;
        place-items: center;
        width: var(--node);
        height: var(--node);
        border-radius: 50%;
        background: var(--accent-bg);
        color: var(--on-accent);
        font-weight: 650;
        font-size: var(--step--1);
        font-variant-numeric: tabular-nums;
        transition:
            background-color 350ms var(--ease-out),
            color 350ms var(--ease-out),
            box-shadow 350ms var(--ease-out);
    }
    h3 {
        font-size: var(--step-1);
        font-weight: 650;
        letter-spacing: -0.01em;
        padding-top: 0.35rem;
    }
    .stage p {
        color: var(--ink-2);
        font-size: var(--step--1);
        max-width: 46ch;
    }

    @media (min-width: 900px) {
        .rail {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            column-gap: 2rem;
        }
        .rail::before,
        .rail::after {
            width: var(--len);
            height: 1px;
            transform-origin: left;
        }
        .rail::after {
            height: 2px;
            margin-left: 0;
            margin-top: -0.5px;
        }
        .stage {
            grid-template-columns: minmax(0, 1fr);
            align-content: start;
            padding-bottom: 0;
            padding-right: 0.5rem;
        }
        .node {
            grid-row: auto;
            margin-bottom: 1rem;
        }
        h3 {
            padding-top: 0;
        }
    }

    /* Before the rail enters view (only when motion is allowed and JS runs). */
    :global(html.reveal) .rail:not(.is-in)::after {
        transform: scale(0);
    }
    :global(html.reveal) .rail:not(.is-in) .node {
        background: var(--ground);
        color: var(--ink-3);
        box-shadow: inset 0 0 0 1px var(--rule-strong);
    }
    :global(html.reveal) .rail::after {
        transition: transform 1400ms cubic-bezier(0.65, 0, 0.35, 1) 150ms;
    }
    :global(html.reveal) .rail.is-in .node {
        transition-delay: calc(150ms + var(--i) * 420ms);
    }

    .payments {
        margin-top: 2.5rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .payments svg {
        width: 1rem;
        height: 1rem;
    }
</style>
