---
import Mark from "./Mark.astro";
import ServiceIcon from "./ServiceIcon.astro";
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="services-title">{t.services.title}</h2>
            <p>{t.services.lede}</p>
        </div>

        <ul class="services">
            {t.services.items.map((s) => (
                <li class="service" id={`service-${s.id}`}>
                    <ServiceIcon id={s.id} />
                    <h3>{s.name}</h3>
                    <p class="body">{s.body}</p>
                    <p class="stack"><span class="sr-only">{t.services.stackLabel}: </span>{s.stack.split(" · ").map((item, i, all) => <>{i > 0 && " "}<span class="tech">{item}{i < all.length - 1 && <span aria-hidden="true"> ·</span>}</span></>)}</p>
                </li>
            ))}
        </ul>

        <div class="plans" aria-labelledby="plans-title">
            <div class="plans-intro">
                <h3 id="plans-title">{t.plans.title}</h3>
                <p>{t.plans.lede}</p>
            </div>
            <div class="plan-cols">
                <div>
                    <h4>{t.plans.includedTitle}</h4>
                    <ul class="checklist">
                        {t.plans.included.map((item) => <li><Mark kind="included" />{item}</li>)}
                    </ul>
                </div>
                <div>
                    <h4>{t.plans.excludedTitle}</h4>
                    <ul class="checklist muted">
                        {t.plans.excluded.map((item) => <li><Mark kind="excluded" />{item}</li>)}
                    </ul>
                </div>
            </div>
            <p class="note">{t.plans.note}</p>
        </div>
    </div>
</section>

<style>
    .services {
        list-style: none;
        padding: 0;
    }
    .service {
        display: grid;
        grid-template-columns: 1.5rem minmax(0, 1fr);
        column-gap: 1.25rem;
        row-gap: 0.5rem;
        padding-block: 1.75rem;
        border-bottom: 1px solid var(--rule);
        scroll-margin-top: 6rem;
    }
    .service :global(.service-icon) {
        margin-top: 0.2rem;
    }
    .service h3 {
        font-size: var(--step-2);
        font-weight: 600;
    }
    .body,
    .stack {
        grid-column: 2;
    }
    .body {
        color: var(--ink-2);
        max-width: 58ch;
    }
    .stack {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .tech {
        white-space: nowrap;
    }
    @media (min-width: 900px) {
        .service {
            grid-template-columns: 1.5rem 4fr 5fr 3fr;
            align-items: baseline;
            column-gap: 2rem;
            padding-block: 2rem;
        }
        .service :global(.service-icon) {
            align-self: start;
            margin-top: 0.15rem;
        }
        .body,
        .stack {
            grid-column: auto;
        }
        .stack {
            text-align: right;
        }
    }

    .plans {
        margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
        display: grid;
        gap: 2.5rem;
        padding-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
        border-top: 1px solid var(--ink);
    }
    @media (min-width: 900px) {
        .plans {
            grid-template-columns: 5fr 7fr;
            column-gap: 4rem;
        }
        .note {
            grid-column: 2;
        }
    }
    .plans-intro h3 {
        font-size: var(--step-2);
        font-weight: 600;
    }
    .plans-intro p {
        margin-top: 0.875rem;
        color: var(--ink-2);
        max-width: 42ch;
    }
    .plan-cols {
        display: grid;
        gap: 2rem;
    }
    @media (min-width: 640px) {
        .plan-cols {
            grid-template-columns: 1fr 1fr;
        }
    }
    h4 {
        font-size: var(--step--1);
        font-weight: 600;
        padding-bottom: 0.75rem;
        margin-bottom: 0.25rem;
        border-bottom: 1px solid var(--ink);
    }
    .checklist {
        list-style: none;
        padding: 0;
    }
    .checklist li {
        display: flex;
        gap: 0.75rem;
        align-items: baseline;
        padding-block: 0.625rem;
        border-bottom: 1px solid var(--rule);
        font-size: var(--step--1);
    }
    .checklist :global(.mark) {
        position: relative;
        top: 0.15em;
    }
    .checklist.muted li {
        color: var(--ink-2);
    }
    .note {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
</style>
