---
import Dotted from "./Dotted.astro";
import ServiceIcon from "./ServiceIcon.astro";
import { getLang, localizePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap">
        <div class="section-head" data-reveal>
            <h2 id="services-title"><Dotted text={t.services.title} period /></h2>
            <p>{t.services.lede}</p>
        </div>

        <ul class="services">
            {t.services.items.map((s, i) => (
                <li class="service" id={`service-${s.id}`} data-reveal style={`--stagger:${i % 2}`}>
                    <ServiceIcon id={s.id} />
                    <h3>{s.name}</h3>
                    <p class="body">{s.body}</p>
                    {s.id === "hosting" && <a class="plan-link" href={localizePath("/work-with-us", lang) + "#plans"}>{t.plans.link}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a>}
                    <p class="stack"><span class="sr-only">{t.services.stackLabel}: </span>{s.stack.split(" · ").map((item, i, all) => <>{i > 0 && " "}<span class="tech">{item}{i < all.length - 1 && <span aria-hidden="true"> ·</span>}</span></>)}</p>
                </li>
            ))}
        </ul>

    </div>
</section>

<style>
    .services {
        list-style: none;
        padding: 0;
    }
    .service {
        display: grid;
        grid-template-columns: 1.5rem minmax(0, 1fr);
        column-gap: 1.25rem;
        row-gap: 0.5rem;
        padding-block: 1.75rem;
        border-bottom: 1px solid var(--rule);
        scroll-margin-top: 6rem;
    }
    .service :global(.service-icon) {
        margin-top: 0.2rem;
    }
    .service h3 {
        font-size: var(--step-2);
        font-weight: 600;
    }
    .body,
    .stack,
    .plan-link {
        grid-column: 2;
    }
    .plan-link {
        justify-self: start;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: var(--step--1);
        font-weight: 500;
        color: var(--green-ink);
        text-decoration: none;
    }
    .plan-link:hover {
        text-decoration: underline;
    }
    .plan-link svg {
        width: 0.875rem;
        height: 0.875rem;
        transition: transform 200ms var(--ease-out);
    }
    .plan-link:hover svg {
        transform: translateX(2px);
    }
    .body {
        color: var(--ink-2);
        max-width: 58ch;
    }
    .stack {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .tech {
        white-space: nowrap;
    }
    @media (min-width: 900px) {
        .service {
            grid-template-columns: 1.5rem 4fr 5fr 3fr;
            align-items: baseline;
            column-gap: 2rem;
            padding-block: 2rem;
        }
        .service :global(.service-icon) {
            align-self: start;
            margin-top: 0.15rem;
        }
        .body,
        .stack {
            grid-column: auto;
        }
        .stack {
            text-align: right;
        }
        .plan-link {
            grid-column: 3;
            grid-row: 2;
            margin-top: 0.25rem;
        }
    }

</style>
