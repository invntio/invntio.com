---
import { getLang, localizePath, useTranslations } from "../i18n/ui";
import { site } from "../config/site";

// JSON-LD for search engines: the business and its services on the home page,
// breadcrumbs on inner pages.
interface Props {
    kind: "home" | "page";
    title?: string;
    updated?: Date;
}

const { kind, title, updated } = Astro.props;
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const home = new URL(localizePath("/", lang), site.url).href;
const url = new URL(Astro.url.pathname, site.url).href;
const orgId = `${site.url}/#organization`;

const organization = {
    "@type": "ProfessionalService",
    "@id": orgId,
    name: "Invntio",
    url: site.url,
    logo: `${site.url}/icon-512.png`,
    image: `${site.url}/${lang === "es" ? "og-es.png" : "og.png"}`,
    email: site.email,
    telephone: site.phone.schema,
    slogan: lang === "es" ? "Desata el potencial de tu negocio" : "Unleash your business potential",
    description: t.meta.description,
    address: { "@type": "PostalAddress", addressRegion: "PA", addressCountry: "US" },
    sameAs: site.profiles,
    areaServed: ["US", "Latin America"],
    knowsAbout: [
        "Custom software development",
        "iOS and Android app development",
        "Web development",
        "API and systems integration",
        "Business process automation",
        "AI automation",
        "Technical SEO",
        "DevOps and DevSecOps",
        "Web hosting and maintenance",
    ],
    knowsLanguage: ["en", "es"],
    contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: site.email,
        telephone: site.phone.schema,
        availableLanguage: ["English", "Spanish"],
    },
    hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: t.services.title,
        itemListElement: t.services.items.map((s) => ({
            "@type": "Offer",
            itemOffered: { "@type": "Service", name: s.name, description: s.body },
        })),
    },
};

// Our own products, so search engines and AI answers know Invntio makes them.
const kinds: Record<string, { type: string; os?: string; category: string }> = {
    Beavo: { type: "MobileApplication", os: "iOS", category: "HealthApplication" },
    Axen: { type: "MobileApplication", os: "iOS", category: "HealthApplication" },
    "Bohío": { type: "WebApplication", category: "BusinessApplication" },
};
const products = t.register.items
    .filter((item) => item.kind === "own" && !item.hidden && kinds[item.name])
    .map((item) => ({
        "@type": kinds[item.name].type,
        "@id": `${item.url}/#app`,
        name: item.name,
        url: item.url,
        description: item.what,
        applicationCategory: kinds[item.name].category,
        ...(kinds[item.name].os && { operatingSystem: kinds[item.name].os }),
        creator: { "@id": orgId },
        publisher: { "@id": orgId },
    }));

const graph =
    kind === "home"
        ? [
              { ...organization, owns: products.map((p) => ({ "@id": p["@id"] })) },
              ...products,
              {
                  "@type": "WebSite",
                  "@id": `${site.url}/#website`,
                  url: home,
                  name: "Invntio",
                  inLanguage: lang,
                  publisher: { "@id": orgId },
              },
          ]
        : [
              {
                  "@type": "WebPage",
                  "@id": url,
                  url,
                  name: title,
                  inLanguage: lang,
                  isPartOf: { "@id": `${site.url}/#website` },
                  publisher: { "@id": orgId },
                  ...(updated && { dateModified: updated.toISOString().slice(0, 10) }),
              },
              {
                  "@type": "BreadcrumbList",
                  itemListElement: [
                      { "@type": "ListItem", position: 1, name: "Invntio", item: home },
                      { "@type": "ListItem", position: 2, name: title, item: url },
                  ],
              },
          ];

const json = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={json} />
