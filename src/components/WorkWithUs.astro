---
import Layout from "../layouts/Layout.astro";
import Dotted from "./Dotted.astro";
import Mark from "./Mark.astro";
import ContactForm from "./ContactForm.astro";
import { getLang, localizePath, useTranslations } from "../i18n/ui";
import { site } from "../config/site";

// Work with us: the offers and their prices, how an engagement runs, guarantees, proof,
// common questions and the contact form. The home page links here instead of selling.
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const h = t.hire;
const home = localizePath("/", lang);
const pageUrl = new URL(Astro.url.pathname, site.url).href;

// The paid entry offer, described where its price is shown.
const subject = {
    "@type": "Service",
    "@id": `${pageUrl}#diagnostic`,
    name: h.ways.items[0].name,
    // The body and the 60-day credit.
    description: [h.diagnostic.body, h.diagnostic.checks[2]].join(" "),
    serviceType: "Software project consultation",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: ["US", "Latin America"],
    availableLanguage: ["English", "Spanish"],
    offers: {
        "@type": "Offer",
        url: site.diagnostic.url,
        price: String(site.diagnostic.price),
        priceCurrency: site.diagnostic.currency,
        availability: "https://schema.org/InStock",
    },
};

// The paid hands-on session, described the same way. Sold on its own, not credited toward a project.
const session = h.ways.items.find((w) => w.book);
const sessionSubject = {
    "@type": "Service",
    "@id": `${pageUrl}#session`,
    name: session?.name,
    description: session?.body,
    serviceType: "Software technical consultation",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: ["US", "Latin America"],
    availableLanguage: ["English", "Spanish"],
    offers: {
        "@type": "Offer",
        url: site.session.url,
        price: String(site.session.price),
        priceCurrency: site.session.currency,
        availability: "https://schema.org/InStock",
    },
};

const arrowOut = "M6 14L14 6M7.5 6H14v6.5";
---

<Layout title={h.title} description={h.description} subject={[subject, sessionSubject]}>
    <header class="wrap intro">
        <div class="pitch">
            <h1><Dotted text={h.heading} period /></h1>
            <p class="lede">{h.lede}</p>
            <dl class="facts" aria-label={h.factsLabel}>
                {h.facts.map((f) => (
                    <div>
                        <dt>{f.label}</dt>
                        <dd>{f.text}</dd>
                    </div>
                ))}
            </dl>
        </div>

        <aside class="offer" id="diagnostic" aria-labelledby="diagnostic-title">
            <div class="offer-head">
                <h2 id="diagnostic-title"><Mark kind="live" /><span><Dotted text={h.diagnostic.title} /></span></h2>
                <p class="offer-price">{h.diagnostic.price}</p>
            </div>
            <p class="offer-body">{h.diagnostic.body}</p>
            <ul class="checks">
                {h.diagnostic.checks.map((c) => <li><Mark kind="included" />{c}</li>)}
            </ul>
            <a class="btn btn-primary book" href={site.diagnostic.url} target="_blank" rel="noopener" data-book-diagnostic>
                {h.diagnostic.cta}<span class="sr-only"> {h.newTab}</span>
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrowOut} /></svg>
            </a>
            <p class="direct">{h.diagnostic.direct} <a href="#write">{h.diagnostic.directLink}</a>.</p>
        </aside>
    </header>

    <section class="wrap block" aria-labelledby="ways-title">
        <div class="split" data-reveal>
            <h2 id="ways-title"><Dotted text={h.ways.title} period /></h2>
            <ul class="ways">
                {h.ways.items.map((w) => (
                    <li>
                        <h3>{w.name}</h3>
                        <p class="price">{w.terms}</p>
                        <p class="what">
                            {w.body}
                            {w.link && (
                                <>
                                    {" "}
                                    <a href={`${home}#plans`}>{w.link}</a>
                                </>
                            )}
                            {w.book && (
                                <>
                                    {" "}
                                    <a class="out" href={site.session.url} target="_blank" rel="noopener" data-book-session>
                                        {w.book}<span class="sr-only"> {h.newTab}</span>
                                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrowOut} /></svg>
                                    </a>
                                </>
                            )}
                        </p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="wrap block" aria-labelledby="steps-title">
        <div class="split" data-reveal>
            <h2 id="steps-title"><Dotted text={h.steps.title} period /></h2>
            <ol class="steps">
                {h.steps.items.map((step, i) => (
                    <li>
                        <span class="node" aria-hidden="true">{i + 1}</span>
                        <h3><span class="sr-only">{i + 1}. </span>{step.name}</h3>
                        <p>{step.body}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="wrap block" aria-labelledby="guarantees-title">
        <div class="split" data-reveal>
            <h2 id="guarantees-title"><Dotted text={h.guarantees.title} period /></h2>
            <div>
                {h.guarantees.groups.map((g) => (
                    <div class="group">
                        <h3>{g.name}</h3>
                        <ul class="checks">
                            {g.items.map((item) => (
                                <li><Mark kind="included" />{item}</li>
                            ))}
                        </ul>
                    </div>
                ))}
                <p class="more">
                    {h.guarantees.more} <a href={localizePath("/refunds", lang) + h.guarantees.refundsAnchor}>{h.guarantees.refunds}</a> {h.guarantees.and} <a href={localizePath("/terms", lang)}>{h.guarantees.terms}</a>.
                </p>
            </div>
        </div>
    </section>

    <section class="wrap block" aria-labelledby="proof-title">
        <div class="split" data-reveal>
            <div>
                <h2 id="proof-title"><Dotted text={h.proof.title} period /></h2>
                <p class="text">{h.proof.lede}</p>
            </div>
            <ul class="cases">
                {t.cases.items.map((c) => (
                    <li>
                        <a class="case-row" href={localizePath(`/work/${c.slug}`, lang)}>
                            <span class="name">
                                {c.name} <span class="kind">{c.kind === "own" ? t.register.ownProduct : t.register.client}</span>
                            </span>
                            <span class="what">{c.outcome}</span>
                            <span class="read">
                                {t.cases.read}
                                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="wrap block" aria-labelledby="faq-title">
        <div class="split" data-reveal>
            <h2 id="faq-title"><Dotted text={h.faq.title} period /></h2>
            <div class="faq">
                {h.faq.items.map((item) => (
                    <details>
                        <summary>
                            <span>{item.q}</span>
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path class="v" d="M8 3v10" /><path d="M3 8h10" /></svg>
                        </summary>
                        <p>{item.a}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="wrap block" aria-labelledby="ready-title">
        <div class="ready" data-reveal>
            <h2 id="ready-title"><Dotted text={h.ready.title} /></h2>
            <div class="actions">
                <a class="btn btn-primary" href={site.diagnostic.url} target="_blank" rel="noopener" data-book-diagnostic>
                    {h.cta}<span class="sr-only"> {h.newTab}</span>
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrowOut} /></svg>
                </a>
                <a class="write" href="#write">
                    {h.ready.write}
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" /></svg>
                </a>
            </div>
        </div>
    </section>

    <ContactForm />
</Layout>

<script>
    document.querySelectorAll("[data-book-diagnostic]").forEach((link) =>
        link.addEventListener("click", () => {
            (window as unknown as { posthog?: { capture: (e: string) => void } }).posthog?.capture("diagnostic_booking_clicked");
        }),
    );
    document.querySelectorAll("[data-book-session]").forEach((link) =>
        link.addEventListener("click", () => {
            (window as unknown as { posthog?: { capture: (e: string) => void } }).posthog?.capture("session_booking_clicked");
        }),
    );
</script>

<style>
    /* Hero: the pitch on the left, the paid entry offer on the right where it can't be missed. */
    .intro {
        padding-top: clamp(2.5rem, 2rem + 3vw, 5rem);
        display: grid;
        gap: 3rem;
    }
    @media (min-width: 1000px) {
        .intro {
            grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
            gap: 4rem;
            align-items: start;
        }
    }
    h1 {
        font-size: var(--step-4);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.02;
        max-width: 16ch;
    }
    .lede {
        margin-top: 1.5rem;
        font-size: var(--step-1);
        color: var(--ink-2);
        max-width: 46ch;
    }
    /* Three facts as a ruled strip, label over value. */
    .facts {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, max-content));
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
    }
    .facts div {
        padding: 0.875rem 1.5rem 0.875rem 0;
    }
    .facts div + div {
        padding-left: 1.5rem;
        border-left: 1px solid var(--rule);
    }
    .facts dt {
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .facts dd {
        margin: 0.125rem 0 0;
        font-weight: 600;
    }
    @media (max-width: 560px) {
        .facts {
            grid-template-columns: minmax(0, 1fr);
        }
        .facts div,
        .facts div + div {
            padding: 0.75rem 0;
            border-left: 0;
        }
        .facts div + div {
            border-top: 1px solid var(--rule);
        }
    }

    /* The offer, set as an entry in the release record: an ink rule, name and price on one line,
       then ruled terms and the one action. No box; it reads like the register on the home page. */
    .offer {
        border-top: 2px solid var(--ink);
    }
    /* Dot, name and price share one baseline: a single row of the record. */
    .offer-head {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.25rem 1rem;
        padding-block: 1rem;
        border-bottom: 1px solid var(--rule);
    }
    .offer h2 {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        font-size: var(--step-1);
        font-weight: 650;
        letter-spacing: -0.01em;
        max-width: none;
    }
    .offer h2 :global(.mark) {
        align-self: center;
        transform: translateY(0.05em);
    }
    .offer-price {
        font-size: var(--step-3);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }
    .offer-body {
        margin-top: 1.25rem;
        font-size: var(--step-1);
        color: var(--ink-2);
        max-width: 40ch;
    }
    .checks {
        list-style: none;
        padding: 0;
        margin: 1.5rem 0 0;
        border-top: 1px solid var(--rule);
        font-size: var(--step--1);
    }
    .checks li {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        padding-block: 0.75rem;
        border-bottom: 1px solid var(--rule);
    }
    .checks :global(.mark) {
        position: relative;
        top: 0.15em;
        flex: none;
    }
    .book {
        margin-top: 1.5rem;
        width: 100%;
        justify-content: center;
    }
    .direct {
        margin-top: 1.25rem;
        font-size: var(--step--1);
        color: var(--ink-3);
    }
    .direct a {
        color: var(--ink);
        font-weight: 500;
    }

    .actions {
        margin-top: 2.25rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.75rem;
    }
    .write {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        min-height: 2.75rem;
        font-weight: 500;
        text-decoration-color: var(--rule-strong);
    }
    .write:hover {
        text-decoration-color: currentColor;
    }
    .write svg {
        width: 1rem;
        height: 1rem;
        color: var(--ink-3);
    }

    /* Each block opens on an ink rule, title left and content right (as on the case pages). */
    .block {
        margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    }
    .split {
        display: grid;
        gap: 1.75rem 4rem;
        padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
        border-top: 1px solid var(--ink);
    }
    @media (min-width: 900px) {
        .split {
            grid-template-columns: 5fr 7fr;
        }
    }
    h2 {
        font-size: var(--step-3);
        max-width: 16ch;
    }
    .text {
        margin-top: 1rem;
        font-size: var(--step-1);
        color: var(--ink-2);
        max-width: 38ch;
    }
    /* Closing call to action, right before the form: the one decision point after the whole case is made. */
    .ready {
        display: grid;
        gap: 1.5rem 4rem;
        padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
        border-top: 1px solid var(--ink);
    }
    @media (min-width: 900px) {
        .ready {
            grid-template-columns: 7fr 5fr;
            align-items: center;
        }
    }
    .ready .actions {
        margin-top: 0;
    }
    a:not(.btn) {
        text-decoration-color: var(--rule-strong);
    }
    a:not(.btn):hover {
        text-decoration-color: currentColor;
    }

    /* Ways to work together: a price list, name and terms on one line. */
    .ways,
    .steps,
    .checks,
    .cases {
        list-style: none;
        padding: 0;
    }
    .ways li {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.375rem 1.5rem;
        padding-block: 1.25rem;
        border-bottom: 1px solid var(--rule);
    }
    .ways li:first-child {
        padding-top: 0;
    }
    .ways h3 {
        font-size: var(--step-2);
        font-weight: 600;
    }
    /* Proportional figures: tabular ones set the comma in "Fixed price, in writing" on a wide cell. */
    .price {
        align-self: baseline;
        text-align: right;
        font-weight: 600;
        white-space: nowrap;
    }
    .ways .what {
        grid-column: 1 / -1;
        color: var(--ink-2);
        max-width: 52ch;
    }
    .ways .what a {
        color: var(--ink);
        font-weight: 500;
    }
    .ways .out {
        white-space: nowrap;
    }
    .ways .out svg {
        display: inline-block;
        width: 0.875rem;
        height: 0.875rem;
        margin-left: 0.125rem;
        vertical-align: -0.0625em;
        color: var(--ink-3);
    }
    @media (max-width: 560px) {
        .ways li {
            grid-template-columns: minmax(0, 1fr);
        }
        .price {
            text-align: left;
            white-space: normal;
        }
    }

    /* Three steps on a ruled list, each led by an outlined node. */
    .steps li {
        display: grid;
        grid-template-columns: 2.25rem minmax(0, 1fr);
        column-gap: 1.25rem;
        row-gap: 0.25rem;
        padding-block: 1.25rem;
        border-bottom: 1px solid var(--rule);
    }
    .steps li:first-child {
        padding-top: 0;
    }
    .node {
        grid-row: span 2;
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--ink);
        border-radius: 50%;
        font-size: var(--step--1);
        font-weight: 650;
        font-variant-numeric: tabular-nums;
    }
    .steps h3 {
        font-size: var(--step-1);
        font-weight: 650;
        letter-spacing: -0.01em;
        padding-top: 0.4rem;
    }
    .steps p {
        color: var(--ink-2);
        max-width: 52ch;
    }

    /* Guarantees, grouped by what they cover. */
    .group + .group {
        margin-top: 2rem;
    }
    .group h3 {
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--rule);
        font-size: var(--step-1);
        font-weight: 650;
        letter-spacing: -0.01em;
    }
    .checks li {
        display: flex;
        gap: 0.75rem;
        padding-block: 0.875rem;
        border-bottom: 1px solid var(--rule);
        max-width: 60ch;
    }
    .checks :global(.mark) {
        flex: none;
        margin-top: 0.3em;
    }
    .more {
        margin-top: 1.5rem;
        font-size: var(--step--1);
        color: var(--ink-2);
    }
    .more a {
        color: var(--ink);
        font-weight: 500;
    }

    /* Case studies: rows that open the case, like the register on the home page. */
    .cases {
        border-top: 1px solid var(--rule);
    }
    .case-row {
        display: grid;
        gap: 0.25rem;
        padding: 1.25rem 0.75rem;
        margin-inline: -0.75rem;
        border-bottom: 1px solid var(--rule);
        border-radius: var(--radius);
        text-decoration: none;
        transition: background-color 200ms var(--ease-out);
    }
    .case-row .name {
        font-size: var(--step-2);
        font-weight: 650;
        letter-spacing: -0.02em;
    }
    .kind {
        margin-left: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0;
        color: var(--ink-3);
        white-space: nowrap;
    }
    .case-row .what {
        color: var(--ink-2);
        max-width: 52ch;
    }
    .read {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: 0.5rem;
        font-size: var(--step--1);
        font-weight: 500;
    }
    .read svg {
        width: 1rem;
        height: 1rem;
        transition: transform 220ms var(--ease-out);
    }
    .case-row:hover,
    .case-row:focus-visible {
        background: var(--surface);
    }
    .case-row:hover .read svg,
    .case-row:focus-visible .read svg {
        transform: translateX(3px);
    }

    /* FAQ: native disclosure rows; the plus folds into a minus when open. */
    .faq {
        border-top: 1px solid var(--rule);
    }
    details {
        border-bottom: 1px solid var(--rule);
    }
    summary {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        padding-block: 1.125rem;
        font-size: var(--step-1);
        font-weight: 600;
        line-height: 1.4;
        cursor: pointer;
        list-style: none;
    }
    summary::-webkit-details-marker {
        display: none;
    }
    summary svg {
        flex: none;
        width: 1rem;
        height: 1rem;
        margin-top: 0.25rem;
        color: var(--ink-3);
        transition: color 150ms var(--ease-out);
    }
    summary:hover svg {
        color: var(--ink);
    }
    summary .v {
        transform-box: fill-box;
        transform-origin: center;
        transition: transform 200ms var(--ease-out);
    }
    details[open] summary .v {
        transform: rotate(90deg);
    }
    details p {
        padding-bottom: 1.25rem;
        padding-right: 2.5rem;
        color: var(--ink-2);
        max-width: 60ch;
    }
</style>
