---
import Layout from "../layouts/Layout.astro";
import Mark from "../components/Mark.astro";
import { ui } from "../i18n/ui";

const en = ui.en;
const es = ui.es;
---

<Layout title={en.notFound.title}>
    <section class="wrap nf">
        <p class="status"><Mark kind="excluded" /> 404 · <span>Not live</span></p>
        <h1>This page isn't live<span class="end-dot">.</span></h1>
        <p class="body">{en.notFound.body}</p>
        <p class="body" lang="es">{es.notFound.body}</p>
        <div class="actions">
            <a class="btn btn-primary" href="/">{en.notFound.cta}</a>
            <a class="btn btn-quiet" href="/es/" lang="es">{es.notFound.cta}</a>
        </div>
    </section>
</Layout>

<style>
    .nf {
        padding-block: clamp(4rem, 3rem + 6vw, 9rem);
        display: grid;
        gap: 1rem;
        justify-items: start;
    }
    .status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: var(--step--1);
        color: var(--ink-3);
        font-variant-numeric: tabular-nums;
    }
    h1 {
        font-size: var(--step-4);
        letter-spacing: -0.035em;
        max-width: 14ch;
    }
    .body {
        color: var(--ink-2);
        font-size: var(--step-1);
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1rem;
    }
</style>
