---
import Layout from "../layouts/Layout.astro";
import { ui } from "../i18n/ui";

const t = ui.en;
---

<Layout title={t.notFound.title}>
    <section class="wrap nf">
        <h1>{t.notFound.title}</h1>
        <p>{t.notFound.body}</p>
        <p lang="es">{ui.es.notFound.body}</p>
        <a class="btn btn-primary" href="/">{t.notFound.cta}</a>
    </section>
</Layout>

<style>
    .nf {
        padding-block: clamp(4rem, 3rem + 6vw, 9rem);
        display: grid;
        gap: 1rem;
        justify-items: start;
    }
    h1 {
        font-size: var(--step-4);
    }
    p {
        color: var(--ink-2);
        font-size: var(--step-1);
    }
    .btn {
        margin-top: 1rem;
    }
</style>
